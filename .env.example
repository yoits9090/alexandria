# Search providers (at least one is needed for live searches)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SEARX_URL=
SERPER_API_KEY=
EXA_API_KEY=
BING_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional OpenAI-compatible answer synthesis used by tools/jcode.py
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

ALEXANDRIA_ADDR=:8080
# Optional API authentication for /v1/search, /search, and /api/search
ALEXANDRIA_API_KEY=
# Optional per-client in-process search request limit per minute; 0 disables
ALEXANDRIA_RATE_LIMIT=
ALEXANDRIA_DEFAULT_MAX_TOKENS=1200
ALEXANDRIA_MAX_TOKENS=8000
ALEXANDRIA_REQUEST_TIMEOUT=12s
